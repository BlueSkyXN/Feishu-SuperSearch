{
  "version": 2,
  "backend": "auto",
  "runtime": {
    "global_concurrency": 6,
    "provider_timeout": "4s",
    "listen": "127.0.0.1:3765"
  },
  "storage": {
    "type": "sqlite",
    "path": "~/.sfs/sfs.db",
    "ttl": "45m"
  },
  "lark_cli": {
    "executable": "lark-cli",
    "profile_args": [],
    "timeout": "8s",
    "max_stdout_bytes": 16777216,
    "max_stderr_bytes": 4194304
  },
  "open_api": {
    "enabled": false,
    "app_id": "",
    "base_url": "https://open.feishu.cn",
    "token_env": "FEISHU_USER_ACCESS_TOKEN",
    "user_open_id": "",
    "timeout": "10s",
    "max_response_bytes": 16777216
  },
  "ai": {
    "enabled": false,
    "provider": "openai-compatible",
    "base_url": "https://api.openai.com/v1",
    "api_key_env": "SFS_AI_API_KEY",
    "model": "",
    "timeout": "45s",
    "max_input_bytes": 4194304,
    "max_response_bytes": 4194304,
    "json_schema": true,
    "planner": {
      "enabled": false,
      "max_output_tokens": 4096
    },
    "rerank": {
      "enabled": false,
      "max_output_tokens": 2048,
      "top_n": 30
    },
    "answer": {
      "enabled": false,
      "max_output_tokens": 4096
    }
  },
  "providers": {
    "enabled": [
      "docs",
      "messages",
      "chats",
      "people",
      "minutes",
      "meetings",
      "calendar",
      "tasks",
      "mail",
      "base",
      "sheets"
    ],
    "disabled": [],
    "weights": {
      "docs": 1.2,
      "messages": 1.2,
      "minutes": 1.1
    },
    "quotas": {
      "docs": 10,
      "messages": 12,
      "minutes": 6
    },
    "routes": {}
  },
  "planner": {
    "type": "rules",
    "timeout": "30s",
    "max_stdout_bytes": 4194304,
    "max_stderr_bytes": 1048576
  },
  "strategy": {
    "profile": "balanced",
    "fusion": "weighted_rrf",
    "pagination": "adaptive",
    "source_quota": true,
    "k0": 60
  },
  "replay": {
    "mode": "off",
    "dir": "~/.sfs/replay"
  },
  "external_providers": []
}
