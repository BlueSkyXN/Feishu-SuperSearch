{
  "name": "super-feishu-search-web",
  "private": true,
  "version": "1.0.3",
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "build:web": "vite build",
    "sync:static": "node scripts/sync-static.mjs",
    "build": "npm run typecheck && npm run build:web && npm run sync:static",
    "check:static": "node scripts/check-static.mjs",
    "verify": "npm run test && npm run build && npm run check:static"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "axe-core": "4.10.3",
    "jsdom": "30.0.1",
    "typescript": "5.8.3",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
