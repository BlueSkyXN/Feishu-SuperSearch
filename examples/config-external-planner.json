{
  "version": 1,
  "backend": "mock",
  "runtime": {
    "global_concurrency": 6,
    "provider_timeout": "4s",
    "session_ttl": "45m",
    "session_dir": "~/.sfs/sessions",
    "listen": "127.0.0.1:3765"
  },
  "planner": {
    "type": "command",
    "command": "python3",
    "args": [
      "examples/external-planner.py"
    ],
    "timeout": "10s",
    "max_stdout_bytes": 4194304,
    "max_stderr_bytes": 1048576
  },
  "providers": {},
  "external_providers": []
}
