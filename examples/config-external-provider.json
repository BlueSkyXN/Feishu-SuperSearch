{
  "version": 1,
  "backend": "mock",
  "runtime": {
    "global_concurrency": 6,
    "provider_timeout": "4s",
    "session_ttl": "45m",
    "session_dir": "~/.sfs/sessions",
    "listen": "127.0.0.1:3765"
  },
  "planner": {
    "type": "rules"
  },
  "providers": {
    "routes": {
      "docs": {
        "search": "example.docs",
        "fetch": "example.docs"
      }
    }
  },
  "external_providers": [
    {
      "descriptor": {
        "id": "example.docs",
        "source": "docs",
        "object_kinds": [
          "document"
        ],
        "operations": {
          "search": true,
          "fetch": true
        },
        "required_identity": [
          "auto",
          "user",
          "bot"
        ],
        "search_limits": {
          "max_query_runes": 200,
          "max_page_size": 20,
          "max_pages": 1
        },
        "batch_limits": {
          "max_fetch_items": 20
        },
        "returned_projection": [
          "head",
          "snippet"
        ],
        "fetchable_projection": [
          "content"
        ],
        "supports_pagination": false,
        "supports_streaming": false,
        "backend": "exec-jsonrpc",
        "version": "example/1"
      },
      "command": "python3",
      "args": [
        "examples/external-provider.py"
      ],
      "timeout": "5s",
      "max_stdout_bytes": 1048576,
      "max_stderr_bytes": 262144,
      "preferred": false
    }
  ]
}
